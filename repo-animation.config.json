{
  "exclude": [
    "AGENTS.md",
    "**/README.md",
    ".gitignore",

    "History_Implementation_plans/**",
    "History-implementations/**",


    "tools/ingestion_debug_ui_react_3/**",

    "data/raw/**",
    "data/generated/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    ".ruff_cache/**",
    "*.lock",
    "*.tsbuildinfo"
  ],
  "include": [],
  "display": {
    "maxDepth": 4,
    "maxVisibleRows": 30,
    "hideButCount": [
      "**/__init__.py"
    ],
    "collapseFolders": [
      "tools/ingestion_debug_ui/**",
      "ingestion_pipeline/configs/**",
      "ingestion_pipeline/tests/**",
      "ingestion_pipeline/docs/**",
      "ingestion_pipeline/storage/**",
      "assistant_runtime/providers/**"
    ],
    "maxChildrenByFolder": {
      "ingestion_pipeline/**": 20,
      "assistant_runtime/**": 5,
      "ingestion_pipeline/tools/**": 15,
      "ingestion_pipeline/crawler/**": 5,
      "ingestion_pipeline/crawler/spider/**": 2,
      "ingestion_pipeline/extract/**": 5,
      "ingestion_pipeline/retrieval/**": 5
    }
  }
}
