{
  "exclude": [
    "AGENTS.md",
    ".gitignore",
    "**/README.md",
    "History_Implementation_plans/**",
    "History-implementations/**",
    "tools/ingestion_debug_ui_react_3/**",
    "data/raw/**",
    "data/generated/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    ".ruff_cache/**",
    "*.lock",
    "*.tsbuildinfo"
  ],
  "include": [],
  "history": {
    "trimEndProgressPercent": 0
  },
  "display": {
    "maxDepth": 4,
    "maxVisibleRows": 25,
    "hideButCount": [
      "**/__init__.py"
    ],
    "sizeTrackingStyle": {
      "baseRowHeightRem": 1.1,
      "maxExtraHeightRem": 2.0,
      "baseFontSizeRem": 0.8125,
      "maxExtraFontSizeRem": 1
    },
    "sizeTrackedNodes": {
      "assistant_runtime": {
        "maxVisualPercent": 90
      },
      "ingestion_pipeline/crawler": {
        "maxVisualPercent": 110
      },
      "ingestion_pipeline/extract": {
        "maxVisualPercent": 90
      },
      "ingestion_pipeline/retrieval": {
        "maxVisualPercent": 120
      },
      "ingestion_pipeline/tools": {
        "maxVisualPercent": 120
      }
    },
    "sizeNormalization": "trackedMax",
    "maxChildrenByFolder": {
      "ingestion_pipeline": 20,
      "assistant_runtime": 5,
      "ingestion_pipeline/tools": 5,
      "ingestion_pipeline/crawler": 5,
      "ingestion_pipeline/crawler/spider": 2,
      "ingestion_pipeline/extract": 5,
      "ingestion_pipeline/retrieval": 5
    }
  }
}
